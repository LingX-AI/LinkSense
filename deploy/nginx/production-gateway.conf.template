log_format linksense_gateway_safe '$request_method $uri $server_protocol';

# Docker's embedded DNS publishes every replica behind the service name.
# Resolve it dynamically so API scale-out and container replacement both take
# effect without pinning Nginx to the first address returned at startup.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

upstream linksense_api {
  zone linksense_api 64k;
  server api:4000 resolve;
  keepalive 64;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;
  server_tokens off;
  access_log /var/log/nginx/access.log linksense_gateway_safe;

  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;

  proxy_intercept_errors on;
  error_page 502 503 504 =503 @linksense_maintenance;

  location = /health/live {
    access_log off;
    default_type application/json;
    return 200 '{"status":"available"}';
  }

  location @linksense_maintenance {
    internal;
    access_log off;
    default_type text/html;
    charset utf-8;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store" always;
    add_header Retry-After "30" always;
    return 503 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>System Maintenance</title><style>body{min-height:100vh;margin:0;display:grid;place-items:center;background:#f7f8fa;color:#202124;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:42rem;padding:3rem;text-align:center}h1{margin:0 0 1rem;font-size:2rem}p{margin:0;color:#5f6368;font-size:1.125rem;line-height:1.7}</style></head><body><main><h1>System Maintenance</h1><p>The system is under maintenance. Please wait a moment.</p></main></body></html>';
  }

  location /api/ {
    if (-f /tmp/linksense-maintenance) {
      return 503;
    }

    # Preserve LinkSense JSON error envelopes. The server-level maintenance
    # page still handles local maintenance responses and non-API upstreams.
    proxy_intercept_errors off;
    proxy_pass http://linksense_api;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto ${NGINX_EXTERNAL_SCHEME};
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location ~ ^/linksense-(?:files|knowledge)(?:/|$) {
    if (-f /tmp/linksense-maintenance) {
      return 503;
    }

    proxy_pass ${NGINX_MINIO_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto ${NGINX_EXTERNAL_SCHEME};
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location = /assistant-html-preview-shell.html {
    if (-f /tmp/linksense-maintenance) {
      return 503;
    }

    # Generated previews intentionally accept arbitrary document resources.
    # Keep this exception scoped to the opaque-origin preview shell, and make
    # it resilient if the Web service later adds restrictive response headers.
    proxy_pass http://web:80;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto ${NGINX_EXTERNAL_SCHEME};
    proxy_set_header Connection "";
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Content-Security-Policy-Report-Only;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Feature-Policy;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Cross-Origin-Embedder-Policy;
    proxy_hide_header Cross-Origin-Opener-Policy;
    proxy_hide_header Cross-Origin-Resource-Policy;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
  }

  location / {
    if (-f /tmp/linksense-maintenance) {
      return 503;
    }

    proxy_pass http://web:80;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto ${NGINX_EXTERNAL_SCHEME};
    proxy_set_header Connection "";
  }
}
