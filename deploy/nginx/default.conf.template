map $uri $linksense_cache_control {
  default "";
  /index.html "no-store";
  /assets/embed-app.js "no-cache";
  /assets/embed-app.css "no-cache";
  ~^/assets/ "public, max-age=31536000, immutable";
  ~^/help/(?:en-US/)?assets/ "public, max-age=31536000, immutable";
  ~^/help/(?:.*\/)?index\.html$ "no-store";
  ~^/help/(?:.*\/)?$ "no-store";
}

log_format linksense_safe '$request_method $uri $server_protocol';

server {
  listen 80;
  listen [::]:80;
  server_name _;
  server_tokens off;
  access_log /var/log/nginx/access.log linksense_safe;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
  # The in-browser XLSX viewer parses workbooks in a same-origin module Worker
  # backed by WebAssembly. Permit only Wasm compilation, not generic eval.
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: blob: http: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https:; form-action 'self' https:; frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com" always;
  add_header Cache-Control $linksense_cache_control always;

  location = /health/live {
    access_log off;
    default_type application/json;
    return 200 '{"status":"available"}';
  }

  location = /assistant-html-preview-shell.html {
    # This shell renders generated documents inside an opaque-origin sandbox.
    # Do not inherit the application CSP or resource policies: preview content
    # must retain its scripts, modules, styles, fonts and network requests.
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  location /api/ {
    proxy_pass http://api:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location = /help {
    return 308 /help/;
  }

  location ^~ /help/ {
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Docusaurus injects a trusted inline bootstrap before hydration to apply
    # the saved color mode without a flash. Keep this exception scoped to the
    # repository-controlled Help Center instead of weakening the Web SPA CSP.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: blob: http: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self'; connect-src 'self' https:; form-action 'self' https:; frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com" always;
    add_header Cache-Control $linksense_cache_control always;
    try_files $uri $uri/ =404;
  }

  # The Alpine Nginx MIME table does not map ES module workers by default.
  # Keep nosniff enabled and serve .mjs files with an executable MIME type.
  location ~ \.mjs$ {
    default_type application/javascript;
    try_files $uri =404;
  }

  location /assets/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
