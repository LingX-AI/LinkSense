# Minimal host-only development configuration.
# Copy this file to the repository root as .env.host. The copied file is
# ignored by Git. These values are development placeholders; never reuse them
# in production.

# Core mode disables knowledge-base services, so Elasticsearch and Docling are
# not required.
LINKSENSE_EDITION=core

# PostgreSQL and Redis must already be running and reachable from this host.
# URL-encode credentials before placing them in a URL.
DATABASE_URL=postgresql://linksense:linksense@127.0.0.1:5432/linksense
REDIS_URL=redis://127.0.0.1:6379/0

# Development-only storage below .data/users/.object-storage. This removes the
# MinIO requirement from the minimal Core setup.
LINKSENSE_OBJECT_STORAGE_PROVIDER=local-filesystem

# Host workers do not bundle the managed Chromium runtime.
LINKSENSE_MANAGED_BROWSER_ENABLED=false

# Every value below must be at least 32 characters and distinct. Replace them
# before sharing a development environment with anyone else.
LINKSENSE_JWT_SECRET=dev-host-jwt-secret-00000000000000000001
LINKSENSE_LOGIN_RATE_LIMIT_HMAC_SECRET=dev-host-login-hmac-00000000000000000002
LINKSENSE_PASSWORD_RESET_RATE_LIMIT_HMAC_SECRET=dev-host-reset-hmac-00000000000000000003
LINKSENSE_CREDENTIAL_MASTER_KEY=dev-host-credential-key-00000000000000000004
LINKSENSE_RUNNER_SHARED_SECRET=dev-host-runner-secret-00000000000000000005

# Defaults are Web 5273, API 4000, Runner 4010, and Help Center 3001. When
# changing the Web port, update both values together.
LINKSENSE_DEV_WEB_ORIGIN=http://localhost:5273
LINKSENSE_DEV_WEB_PORT=5273
