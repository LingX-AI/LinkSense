log_format linksense_gateway_safe '$request_method $uri $server_protocol';
resolver 127.0.0.11 valid=10s ipv6=off;

# Prefer a valid protocol reported by an outer reverse proxy. Direct installs
# continue to use the scheme detected by the installer.
map $http_x_forwarded_proto $linksense_forwarded_proto {
  default ${NGINX_EXTERNAL_SCHEME};
  ~*^http$ http;
  ~*^https$ https;
}

upstream linksense_api {
  zone linksense_api 64k;
  server api:4000 resolve;
  keepalive 32;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;
  server_tokens off;
  access_log /var/log/nginx/access.log linksense_gateway_safe;
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;

  location = /health/live {
    access_log off;
    default_type application/json;
    return 200 '{"status":"available"}';
  }

  location /api/ {
    proxy_pass http://linksense_api;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $linksense_forwarded_proto;
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location ~ ^/linksense-(?:files|knowledge)(?:/|$) {
    proxy_pass ${NGINX_MINIO_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $linksense_forwarded_proto;
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location / {
    proxy_pass http://web:80;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $linksense_forwarded_proto;
    proxy_set_header Connection "";
  }
}
