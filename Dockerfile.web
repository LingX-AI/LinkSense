# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-trixie-slim@sha256:9aa7037f0da5b7578ba0d9974d6970da91017e019929ec85eb4e7da22af83b1b
ARG LINKSENSE_NODE_PACKAGE_REGISTRY_URL=https://registry.npmjs.org/

FROM ${NODE_IMAGE} AS dependencies
ARG LINKSENSE_NODE_PACKAGE_REGISTRY_URL
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=${PNPM_HOME}:${PATH}
ENV NPM_CONFIG_REGISTRY=${LINKSENSE_NODE_PACKAGE_REGISTRY_URL}
RUN corepack_registry="${LINKSENSE_NODE_PACKAGE_REGISTRY_URL%/}" \
  && corepack enable \
  && COREPACK_NPM_REGISTRY="${corepack_registry}" corepack prepare pnpm@10.34.6 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY patches patches
COPY apps/api/package.json apps/api/package.json
COPY apps/docs/package.json apps/docs/package.json
COPY apps/runner/package.json apps/runner/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
# Share downloaded packages across root-owned builds even after a lockfile edit.
ARG TARGETARCH
ARG TARGETVARIANT
RUN --mount=type=cache,id=linksense-pnpm-node24-${TARGETARCH}${TARGETVARIANT}-root,target=/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile --prefer-offline --store-dir=/pnpm/store --package-import-method=copy

FROM dependencies AS docs-build
COPY apps/docs apps/docs
ARG DOCS_BUILD_NODE_OPTIONS=
ARG DOCS_BUILD_TERSER_PARALLEL=true
RUN NODE_OPTIONS="${DOCS_BUILD_NODE_OPTIONS}" TERSER_PARALLEL="${DOCS_BUILD_TERSER_PARALLEL}" \
  pnpm --filter @linksense/docs build

# Development serves exactly the same bilingual static build as production.
FROM nginx:1.30-alpine AS docs-runtime
ARG SECURITY_REBUILD_ID=local
RUN test -n "$SECURITY_REBUILD_ID" && apk upgrade --no-cache
COPY --chmod=0444 LICENSE /usr/share/licenses/linksense/LICENSE
COPY --chmod=0444 LICENSE-EXCEPTIONS.md ATTRIBUTION.md TRADEMARK.md NOTICE /usr/share/licenses/linksense/
COPY deploy/nginx/development-docs.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/help-location.conf /etc/nginx/linksense/help-location.conf
COPY --from=docs-build /workspace/apps/docs/build /usr/share/nginx/html/help
RUN chmod -R u=rwX,go=rX /usr/share/nginx/html
ARG DOCS_IMAGE_FINGERPRINT=unversioned
LABEL com.linksense.docs.fingerprint=${DOCS_IMAGE_FINGERPRINT}
EXPOSE 80

FROM dependencies AS build-identity
RUN --mount=type=bind,target=/source \
  node /source/scripts/application-build.mjs id /source > /linksense-build-id

FROM dependencies AS build
COPY --from=build-identity /linksense-build-id /linksense-build-id
COPY scripts/application-build.mjs scripts/source-fingerprint.mjs scripts/application-build.d.mts scripts/
COPY apps/web apps/web
COPY packages/shared packages/shared
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm --filter @linksense/shared build \
  && LINKSENSE_BUILD_ID="$(cat /linksense-build-id)" pnpm --filter @linksense/web build

FROM nginx:1.30-alpine AS runtime
ARG SECURITY_REBUILD_ID=local
RUN test -n "$SECURITY_REBUILD_ID" && apk upgrade --no-cache
ENV NGINX_ENVSUBST_FILTER=^NGINX_
ENV NGINX_CLIENT_MAX_BODY_SIZE=110m
COPY --chmod=0444 LICENSE /usr/share/licenses/linksense/LICENSE
COPY --chmod=0444 LICENSE-EXCEPTIONS.md ATTRIBUTION.md TRADEMARK.md NOTICE /usr/share/licenses/linksense/
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/help-location.conf /etc/nginx/linksense/help-location.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
COPY --from=docs-build /workspace/apps/docs/build /usr/share/nginx/html/help
# Production Git checkout intentionally uses umask 077. Vite preserves the
# source mode of copied public assets, so normalize the complete static tree
# only after both Web and Help Center files have been copied.
RUN chmod -R u=rwX,go=rX /usr/share/nginx/html
EXPOSE 80
