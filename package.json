{
  "name": "link-sense",
  "version": "0.1.0",
  "description": "A self-hosted AI task agent platform for organizations.",
  "private": true,
  "license": "CPAL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LingX-AI/linksense.git"
  },
  "bugs": {
    "url": "https://github.com/LingX-AI/linksense/issues"
  },
  "homepage": "https://github.com/LingX-AI/linksense#readme",
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "pnpm --parallel --stream --filter @linksense/api --filter @linksense/runner --filter @linksense/web --filter @linksense/docs dev",
    "dev:prepare": "node scripts/dev.mjs --prepare-only",
    "dev:rebuild": "node scripts/dev.mjs --rebuild",
    "dev:worker:rebuild": "node scripts/dev.mjs --worker-rebuild",
    "dev:prod": "node scripts/dev.mjs --production",
    "dev:prod:stop": "node scripts/dev.mjs --production --stop",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:down": "node scripts/dev.mjs --down",
    "build": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "knowledge:reset-storage": "pnpm --filter @linksense/api knowledge:reset-storage",
    "lint": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present lint",
    "test": "pnpm --filter @linksense/shared build && pnpm run test:deployment && pnpm -r --workspace-concurrency=1 --filter './apps/**' --filter './packages/**' --if-present test",
    "test:deployment": "node --test scripts/*.test.mjs",
    "test:runtime:standalone": "pnpm --filter @linksense/runner exec tsx ../../scripts/runtime-standalone-smoke.mts",
    "benchmark:latency": "node scripts/latency-smoke.mjs",
    "test:codex:integration": "tsx scripts/codex-thread-smoke.mts",
    "test:codex:model-gateway": "tsx scripts/codex-model-gateway-smoke.mts",
    "test:codex:model-switch": "tsx scripts/codex-model-switch-smoke.mts",
    "test:codex:native-plugin-refresh": "tsx scripts/codex-native-plugin-refresh-smoke.mts",
    "test:codex:skill-discovery": "tsx scripts/codex-skill-discovery-smoke.mts",
    "typecheck": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present typecheck"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "prisma": "7.8.0",
    "tsx": "^4.20.6",
    "ws": "8.21.2"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<1.19.17": "1.19.17",
      "brace-expansion@<5.0.9": "5.0.9",
      "deepmerge-ts@<8.0.2": "8.0.2",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.3": "4.1.3",
      "fast-xml-parser@>=5.9.3 <5.10.1": "5.10.1",
      "find-my-way@<9.9.0": "9.9.0",
      "hono@<4.13.5": "4.13.5",
      "ip-address@<10.5.0": "10.5.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "mermaid@>=11.0.0 <11.17.2": "11.17.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@>=8.0.0 <8.5.26": "8.5.26",
      "serialize-javascript@<7.0.5": "7.0.5",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "uuid@<11.1.1": "11.1.1",
      "valibot@<1.4.2": "1.4.2",
      "exceljs>archiver": "7.0.1",
      "exceljs>unzipper": "0.12.3",
      "exceljs>uuid": "11.1.1"
    },
    "patchedDependencies": {
      "@extend-ai/react-xlsx@0.14.1": "patches/@extend-ai__react-xlsx@0.14.1.patch",
      "@file-viewer/renderer-spreadsheet@2.2.4": "patches/@file-viewer__renderer-spreadsheet@2.2.4.patch",
      "pptx-react-viewer@1.17.0": "patches/pptx-react-viewer@1.17.0.patch",
      "@easyops-cn/docusaurus-search-local@0.55.3": "patches/@easyops-cn__docusaurus-search-local@0.55.3.patch"
    }
  }
}
