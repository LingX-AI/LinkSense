{
  "name": "link-sense",
  "version": "0.3.4",
  "description": "A self-hosted AI task agent platform for organizations.",
  "private": true,
  "license": "CPAL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LingX-AI/linksense.git"
  },
  "bugs": {
    "url": "https://github.com/LingX-AI/linksense/issues"
  },
  "homepage": "https://github.com/LingX-AI/linksense#readme",
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:host": "LINKSENSE_ENV_FILE=.env.host node scripts/dev-host.mjs",
    "dev:host:cleanup": "node scripts/dev-host.mjs --cleanup",
    "dev:apps": "pnpm --parallel --stream --filter @linksense/api --filter @linksense/runner --filter @linksense/web --filter @linksense/docs dev",
    "dev:prepare": "node scripts/dev.mjs --prepare-only",
    "dev:benchmark": "node scripts/dev-benchmark.mjs",
    "dev:rebuild": "node scripts/dev.mjs --rebuild",
    "dev:worker:rebuild": "node scripts/dev.mjs --worker-rebuild",
    "dev:prod": "node scripts/dev.mjs --production",
    "dev:prod:stop": "node scripts/dev.mjs --production --stop",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:down": "node scripts/dev.mjs --down",
    "build": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "knowledge:reset-storage": "pnpm --filter @linksense/api knowledge:reset-storage",
    "lint": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present lint",
    "test": "pnpm --filter @linksense/shared build && pnpm run '/^test:(deployment|packages)$/' && pnpm --filter @linksense/web test",
    "test:deployment": "node --test --test-concurrency=2 scripts/*.test.mjs",
    "test:runtime:standalone": "pnpm --filter @linksense/runner exec tsx ../../scripts/runtime-standalone-smoke.mts",
    "test:runtime:docker-shared-home": "pnpm --filter @linksense/runner build && tsx scripts/docker-shared-home-smoke.mts",
    "benchmark:latency": "node scripts/latency-smoke.mjs",
    "benchmark:prompt-cache": "pnpm --filter @linksense/runner exec tsx test/fixtures/prompt-cache-benchmark/run.ts",
    "test:codex:shared-home": "tsx scripts/codex-shared-home-smoke.mts",
    "test:codex:integration": "tsx scripts/codex-thread-smoke.mts",
    "test:codex:upgrade": "pnpm --filter @linksense/runner exec tsx test/functional/codex-upgrade.ts",
    "test:codex:upgrade:postgres": "pnpm --filter @linksense/api exec tsx test/integration/async-user-input-postgres.ts",
    "test:connections:postgres": "pnpm --filter @linksense/api exec tsx test/integration/connections-postgres.ts",
    "test:codex:model-gateway": "tsx scripts/codex-model-gateway-smoke.mts",
    "test:codex:model-switch": "tsx scripts/codex-model-switch-smoke.mts",
    "test:codex:native-plugin-refresh": "tsx scripts/codex-native-plugin-refresh-smoke.mts",
    "test:codex:skill-discovery": "tsx scripts/codex-skill-discovery-smoke.mts",
    "typecheck": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present typecheck",
    "test:packages": "pnpm -r --parallel --filter './apps/**' --filter './packages/**' --filter '!@linksense/web' --if-present test",
    "test:runtime:projects:postgres": "pnpm --filter @linksense/api exec tsx test/integration/user-project-runtime-postgres.ts",
    "test:interactive-files:postgres": "pnpm --filter @linksense/api exec tsx test/integration/interactive-files-postgres.ts",
    "test:development-instructions:postgres": "pnpm --filter @linksense/api exec tsx test/integration/development-turn-instructions-postgres.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "chokidar": "5.0.0",
    "prisma": "7.8.0",
    "tsx": "^4.20.6",
    "ws": "8.21.2",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<1.19.17": "1.19.17",
      "@xmldom/xmldom@<0.9.12": "0.9.12",
      "@node-saml/node-saml>@xmldom/xmldom": "0.8.15",
      "xml-crypto>@xmldom/xmldom": "0.8.15",
      "browserslist@<=4.28.6": "4.28.7",
      "@fastify/busboy@<3.2.1": "3.2.1",
      "basic-ftp@<6.2.1": "6.2.1",
      "brace-expansion@<5.0.11": "5.0.11",
      "deepmerge-ts@<8.0.2": "8.0.2",
      "fast-uri@>=3.0.0 <3.1.7": "3.1.7",
      "fast-uri@>=4.0.0 <4.1.4": "4.1.4",
      "fast-xml-parser@>=5.9.3 <5.10.1": "5.10.1",
      "find-my-way@<9.9.0": "9.9.0",
      "hono@<4.13.5": "4.13.5",
      "ip-address@<10.5.0": "10.5.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash-es@<4.18.0": "4.18.1",
      "mermaid@>=11.0.0 <11.17.2": "11.17.2",
      "@file-viewer/doc@<2.3.1": "2.3.1",
      "mysql2@<3.22.0": "3.22.0",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@>=8.0.0 <8.5.26": "8.5.26",
      "proxy-addr@<2.0.8": "2.0.8",
      "source-map-js@<1.2.2": "1.2.2",
      "prosemirror-view@<1.42.3": "1.42.3",
      "serialize-javascript@<7.0.5": "7.0.5",
      "undici@>=6.0.0 <6.28.1": "6.28.1",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "uuid@<11.1.1": "11.1.1",
      "valibot@<1.4.2": "1.4.2",
      "exceljs>archiver": "7.0.1",
      "exceljs>unzipper": "0.12.3",
      "exceljs>uuid": "11.1.1"
    },
    "patchedDependencies": {
      "@extend-ai/react-xlsx@0.14.1": "patches/@extend-ai__react-xlsx@0.14.1.patch",
      "@file-viewer/renderer-spreadsheet@2.2.4": "patches/@file-viewer__renderer-spreadsheet@2.2.4.patch",
      "pptx-react-viewer@1.17.0": "patches/pptx-react-viewer@1.17.0.patch",
      "@easyops-cn/docusaurus-search-local@0.55.3": "patches/@easyops-cn__docusaurus-search-local@0.55.3.patch"
    }
  }
}
