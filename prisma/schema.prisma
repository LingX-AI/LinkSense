model McpServer {
  id                       String    @id @default(uuid()) @db.Uuid
  ownerId                  String    @map("owner_id") @db.Uuid
  name                     String    @db.VarChar(160)
  serverKey                String    @map("server_key") @db.VarChar(40)
  transport                String    @default("streamable_http") @db.VarChar(32)
  url                      String?   @db.Text
  command                  String?   @db.VarChar(512)
  argsJson                 Json      @default("[]") @map("args_json") @db.JsonB
  encryptedEnvironment     String?   @map("encrypted_environment") @db.Text
  environmentKeysJson      Json      @default("[]") @map("environment_keys_json") @db.JsonB
  authType                 String    @map("auth_type") @db.VarChar(32)
  apiKeyHeader             String?   @map("api_key_header") @db.VarChar(120)
  encryptedCredential      String?   @map("encrypted_credential") @db.Text
  encryptionKeyId          String?   @map("encryption_key_id") @db.VarChar(120)
  status                   String    @default("active") @db.VarChar(32)
  required                 Boolean   @default(false)
  startupTimeoutSeconds    Int       @default(60) @map("startup_timeout_seconds")
  toolTimeoutSeconds       Int       @default(600) @map("tool_timeout_seconds")
  insecureHttpAcknowledged Boolean   @default(false) @map("insecure_http_acknowledged")
  lastTestStatus           String?   @map("last_test_status") @db.VarChar(32)
  lastTestErrorCode        String?   @map("last_test_error_code") @db.VarChar(120)
  lastTestedAt             DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastUsedAt               DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerId, serverKey], map: "mcp_servers_owner_server_key_key")
  @@index([ownerId, status, updatedAt(sort: Desc)], map: "mcp_servers_owner_status_updated_idx")
  @@map("mcp_servers")
}

