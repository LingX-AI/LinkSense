  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerHandle, slug], map: "clawhub_skills_owner_slug_key")
  @@index([available, downloadCount(sort: Desc), slug], map: "clawhub_skills_available_download_slug_idx")
  @@index([available, starCount(sort: Desc), slug], map: "clawhub_skills_available_star_slug_idx")
  @@index([available, sourceUpdatedAt(sort: Desc), slug], map: "clawhub_skills_available_updated_slug_idx")
  @@index([lastSeenSyncRunId], map: "clawhub_skills_last_seen_run_idx")
  @@map("clawhub_skills")
