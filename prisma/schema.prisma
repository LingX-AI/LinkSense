generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
  extensions   = [citext, pg_trgm, pgcrypto]
}

// LinkSense intentionally does not declare Prisma relation fields. All UUID
// references below are logical references enforced by services and
// transactions, so migrations must never emit database foreign keys.
// PostgreSQL check constraints, partial unique indexes, expression indexes,
// and GIN/trigram indexes are defined in the checked-in initialization SQL.

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique(map: "users_email_key") @db.Citext
  name                     String    @db.VarChar(120)
  avatarObjectKey          String?   @map("avatar_object_key") @db.Text
  role                     String    @db.VarChar(32)
  status                   String    @db.VarChar(32)
  passwordHash             String?   @map("password_hash") @db.Text
  preferredLocale          String?   @map("preferred_locale") @db.VarChar(16)
  selfRegisteredAt         DateTime? @map("self_registered_at") @db.Timestamptz(6)
  preferredModel           String?   @map("preferred_model") @db.VarChar(240)
  preferredReasoningEffort String?   @map("preferred_reasoning_effort") @db.VarChar(32)
  runningMessageAction     String    @default("queue") @map("running_message_action") @db.VarChar(32)
  totalCreditLimitMicros   BigInt?   @map("total_credit_limit_micros") @db.BigInt
  weeklyCreditLimitMicros  BigInt?   @map("weekly_credit_limit_micros") @db.BigInt
  monthlyCreditLimitMicros BigInt?   @map("monthly_credit_limit_micros") @db.BigInt
  creditQuotaResetAt       DateTime? @map("credit_quota_reset_at") @db.Timestamptz(6)
  lastLoginAt              DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginMethod          String?   @map("last_login_method") @db.VarChar(32)
  passwordUpdatedAt        DateTime? @map("password_updated_at") @db.Timestamptz(6)
  authValidAfter           DateTime  @default(now()) @map("auth_valid_after") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, role], map: "users_status_role_idx")
  @@index([lastLoginAt], map: "users_last_login_at_idx")
  @@index([selfRegisteredAt], map: "users_self_registered_at_idx")
  @@map("users")
}

model UserGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique(map: "user_groups_name_key") @db.VarChar(120)
  description String?  @db.Text
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdBy], map: "user_groups_created_by_idx")
  @@map("user_groups")
}

model UserGroupMember {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  userGroupId String    @map("user_group_id") @db.Uuid
  status      String    @db.VarChar(32)
  createdBy   String?   @map("created_by") @db.Uuid
  revokedBy   String?   @map("revoked_by") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userGroupId, status], map: "user_group_members_group_status_idx")
  @@index([userId, status], map: "user_group_members_user_status_idx")
  @@index([createdBy], map: "user_group_members_created_by_idx")
  @@index([revokedBy], map: "user_group_members_revoked_by_idx")
  @@map("user_group_members")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  parentTokenId     String?   @map("parent_token_id") @db.Uuid
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  tokenHash         String    @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.Text
  userAgent         String?   @map("user_agent") @db.Text
  ipAddress         String?   @map("ip_address") @db.Inet
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(80)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt], map: "refresh_tokens_user_expires_idx")
  @@index([familyId, createdAt], map: "refresh_tokens_family_created_idx")
  @@index([parentTokenId], map: "refresh_tokens_parent_idx")
  @@index([replacedByTokenId], map: "refresh_tokens_replaced_by_idx")
  @@index([revokedAt], map: "refresh_tokens_revoked_at_idx")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestIp        String?   @map("request_ip") @db.Inet
  requestUserAgent String?   @map("request_user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, consumedAt, expiresAt], map: "password_reset_tokens_user_state_idx")
  @@map("password_reset_tokens")
}

model RegistrationToken {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @db.Citext
  tokenHash        String    @unique(map: "registration_tokens_token_hash_key") @map("token_hash") @db.Text
  locale           String    @db.VarChar(16)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestIp        String?   @map("request_ip") @db.Inet
  requestUserAgent String?   @map("request_user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, consumedAt, expiresAt], map: "registration_tokens_email_state_idx")
  @@index([consumedAt, expiresAt], map: "registration_tokens_state_idx")
  @@map("registration_tokens")
}

model Capability {
  id                   String   @id @default(uuid()) @db.Uuid
  type                 String   @db.VarChar(32)
  ownerId              String   @map("owner_id") @db.Uuid
  name                 String   @db.VarChar(160)
  displayName          String?  @map("display_name") @db.VarChar(64)
  slug                 String   @db.VarChar(180)
  description          String?  @db.Text
  sourceType           String   @map("source_type") @db.VarChar(32)
  marketplaceListingId String?  @map("marketplace_listing_id") @db.Uuid
  marketplaceReleaseId String?  @map("marketplace_release_id") @db.Uuid
  logoObjectKey        String?  @map("logo_object_key") @db.Text
  storagePath          String   @map("storage_path") @db.Text
  manifestJson         Json?    @map("manifest_json") @db.JsonB
  riskSummaryJson      Json?    @map("risk_summary_json") @db.JsonB
  status               String   @db.VarChar(32)
  installedBy          String   @map("installed_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerId, slug, type], map: "capabilities_owner_slug_type_key")
  @@unique([ownerId, marketplaceListingId], map: "capabilities_owner_marketplace_listing_key")
  @@index([type, status], map: "capabilities_type_status_idx")
  @@index([ownerId], map: "capabilities_owner_id_idx")
  @@index([marketplaceListingId], map: "capabilities_marketplace_listing_id_idx")
  @@index([marketplaceReleaseId], map: "capabilities_marketplace_release_id_idx")
  @@index([installedBy], map: "capabilities_installed_by_idx")
  @@index([name], map: "capabilities_name_idx")
  @@map("capabilities")
}

model MarketplaceListing {
  id               String    @id @default(uuid()) @db.Uuid
  publisherId      String    @map("publisher_id") @db.Uuid
  publisherName    String    @map("publisher_name") @db.VarChar(120)
  type             String    @db.VarChar(32)
  slug             String    @db.VarChar(180)
  status           String    @db.VarChar(32)
  installCount     Int       @default(0) @map("install_count")
  currentReleaseId String?   @map("current_release_id") @db.Uuid
  suspendedBy      String?   @map("suspended_by") @db.Uuid
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?   @map("suspension_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, slug], map: "marketplace_listings_type_slug_key")
  @@index([publisherId, status, updatedAt(sort: Desc)], map: "marketplace_listings_publisher_status_updated_idx")
  @@index([status, type, updatedAt(sort: Desc)], map: "marketplace_listings_status_type_updated_idx")
  @@index([currentReleaseId], map: "marketplace_listings_current_release_id_idx")
  @@index([suspendedBy], map: "marketplace_listings_suspended_by_idx")
  @@map("marketplace_listings")
}

model MarketplaceRelease {
  id                 String    @id @default(uuid()) @db.Uuid
  listingId          String    @map("listing_id") @db.Uuid
  sourceCapabilityId String    @map("source_capability_id") @db.Uuid
  releaseNumber      Int       @map("release_number")
  status             String    @db.VarChar(32)
  name               String    @db.VarChar(160)
  displayName        String?   @map("display_name") @db.VarChar(64)
  description        String?   @db.Text
  releaseNotes       String?   @map("release_notes") @db.Text
  logoObjectKey      String?   @map("logo_object_key") @db.Text
  packagePath        String    @map("package_path") @db.Text
  contentSha256      String    @map("content_sha256") @db.VarChar(64)
  manifestJson       Json      @map("manifest_json") @db.JsonB
  riskSummaryJson    Json      @map("risk_summary_json") @db.JsonB
  submittedBy        String    @map("submitted_by") @db.Uuid
  reviewerId         String?   @map("reviewer_id") @db.Uuid
  reviewComment      String?   @map("review_comment") @db.Text
  submittedAt        DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([listingId, releaseNumber], map: "marketplace_releases_listing_number_key")
  @@index([listingId, status, submittedAt(sort: Desc)], map: "marketplace_releases_listing_status_submitted_idx")
  @@index([status, submittedAt], map: "marketplace_releases_status_submitted_idx")
  @@index([sourceCapabilityId], map: "marketplace_releases_source_capability_id_idx")
  @@index([submittedBy], map: "marketplace_releases_submitted_by_idx")
  @@index([reviewerId], map: "marketplace_releases_reviewer_id_idx")
  @@map("marketplace_releases")
}

