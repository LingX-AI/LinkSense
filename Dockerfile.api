# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-trixie-slim@sha256:9aa7037f0da5b7578ba0d9974d6970da91017e019929ec85eb4e7da22af83b1b
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ARG UV_VERSION=0.9.13
ARG DEBIAN_MIRROR_URL=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR_URL=http://security.debian.org/debian-security
ARG LINKSENSE_NODE_PACKAGE_REGISTRY_URL=https://registry.npmjs.org/
ARG PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ${NODE_IMAGE} AS node-distribution
FROM ${UBUNTU_IMAGE} AS node-runtime
ARG UBUNTU_MIRROR_URL
ARG UBUNTU_SECURITY_MIRROR_URL
COPY --from=node-distribution /usr/local/ /usr/local/
COPY --chmod=0755 deploy/docker/bootstrap-ubuntu-node.sh /usr/local/bin/bootstrap-ubuntu-node
ARG SECURITY_REBUILD_ID=local
RUN test -n "$SECURITY_REBUILD_ID" && UBUNTU_MIRROR_URL="${UBUNTU_MIRROR_URL}" UBUNTU_SECURITY_MIRROR_URL="${UBUNTU_SECURITY_MIRROR_URL}" /usr/local/bin/bootstrap-ubuntu-node

FROM ${NODE_IMAGE} AS toolchain
ARG DEBIAN_MIRROR_URL
ARG DEBIAN_SECURITY_MIRROR_URL
ARG LINKSENSE_NODE_PACKAGE_REGISTRY_URL
ARG PRISMA_ENGINES_MIRROR
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=${PNPM_HOME}:${PATH}
ENV NPM_CONFIG_REGISTRY=${LINKSENSE_NODE_PACKAGE_REGISTRY_URL}
RUN corepack_registry="${LINKSENSE_NODE_PACKAGE_REGISTRY_URL%/}" \
  && corepack enable \
  && COREPACK_NPM_REGISTRY="${corepack_registry}" corepack prepare pnpm@10.34.6 --activate
WORKDIR /workspace
COPY --chmod=0755 deploy/docker/configure-debian-apt.sh /usr/local/bin/configure-debian-apt
RUN DEBIAN_MIRROR_URL="${DEBIAN_MIRROR_URL}" \
    DEBIAN_SECURITY_MIRROR_URL="${DEBIAN_SECURITY_MIRROR_URL}" \
    /usr/local/bin/configure-debian-apt \
  && apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

FROM toolchain AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml prisma.config.ts tsconfig.base.json ./
COPY patches patches
COPY apps/api/package.json apps/api/package.json
COPY apps/docs/package.json apps/docs/package.json
COPY apps/runner/package.json apps/runner/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
# Share downloaded packages across root-owned builds even after a lockfile edit.
ARG TARGETARCH
ARG TARGETVARIANT
RUN --mount=type=cache,id=linksense-pnpm-node24-${TARGETARCH}${TARGETVARIANT}-root,target=/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile --prefer-offline --store-dir=/pnpm/store --package-import-method=copy

FROM dependencies AS build-identity
RUN --mount=type=bind,target=/source \
  node /source/scripts/application-build.mjs id /source > /linksense-build-id

FROM dependencies AS build
COPY --from=build-identity /linksense-build-id /linksense-build-id
COPY scripts/application-build.mjs scripts/source-fingerprint.mjs scripts/
ARG PRISMA_ENGINES_MIRROR
ENV PRISMA_ENGINES_MIRROR=${PRISMA_ENGINES_MIRROR}
COPY apps/api apps/api
COPY apps/docs/docs apps/docs/docs
COPY apps/docs/i18n/en-US/docusaurus-plugin-content-docs/current apps/docs/i18n/en-US/docusaurus-plugin-content-docs/current
COPY packages/shared packages/shared
COPY prisma prisma
# Prisma 7 loads prisma.config.ts even for client generation. Generation does
# not connect to PostgreSQL, but the config still requires a syntactically
# valid URL; keep this build-only placeholder out of every runtime image.
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build pnpm db:generate \
  && pnpm --filter @linksense/shared build \
  && LINKSENSE_BUILD_ID="$(cat /linksense-build-id)" pnpm --filter @linksense/api build
# Legacy deploy also installs packages; keep access to the same download store.
RUN --mount=type=cache,id=linksense-pnpm-node24-${TARGETARCH}${TARGETVARIANT}-root,target=/pnpm/store,sharing=locked \
  --mount=type=cache,id=linksense-pnpm-metadata-root,target=/pnpm/metadata,sharing=locked \
  pnpm --filter @linksense/api deploy --prod --legacy --prefer-offline --cache-dir=/pnpm/metadata /opt/linksense-api

FROM toolchain AS migration-dependencies
WORKDIR /migration-runtime
COPY deploy/migration/package.json deploy/migration/pnpm-lock.yaml ./
ARG TARGETARCH
ARG TARGETVARIANT
RUN --mount=type=cache,id=linksense-pnpm-node24-${TARGETARCH}${TARGETVARIANT}-root,target=/pnpm/store,sharing=locked \
  pnpm install --prod --frozen-lockfile --ignore-workspace --prefer-offline --store-dir=/pnpm/store --package-import-method=copy
COPY prisma.config.ts ./prisma.config.ts
COPY prisma ./prisma
ARG PRISMA_ENGINES_MIRROR
ENV PRISMA_ENGINES_MIRROR=${PRISMA_ENGINES_MIRROR}
# Generate with the isolated CLI so its platform-specific engines are already
# present when an offline production host starts the migration container.
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build pnpm exec prisma generate

# Ship only the migration CLI, seed dependencies and generated client. Web,
# test and API build dependencies never enter this production image.
FROM node-runtime AS migration
ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace
COPY --from=toolchain /pnpm/corepack /pnpm/corepack
RUN corepack enable pnpm
ARG MIGRATION_IMAGE_FINGERPRINT=unversioned
LABEL com.linksense.migration.fingerprint=${MIGRATION_IMAGE_FINGERPRINT}
COPY --chmod=0444 LICENSE /usr/share/licenses/linksense/LICENSE
COPY --chmod=0444 LICENSE-EXCEPTIONS.md ATTRIBUTION.md TRADEMARK.md NOTICE /usr/share/licenses/linksense/
RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx
COPY --from=migration-dependencies /migration-runtime/node_modules ./node_modules
COPY deploy/migration/package.json ./package.json
COPY prisma.config.ts ./prisma.config.ts
COPY prisma ./prisma
COPY --from=migration-dependencies /migration-runtime/apps/api/src/generated ./apps/api/src/generated
CMD ["sh", "-c", "pnpm db:migrate:deploy && pnpm db:seed"]

FROM node-runtime AS runtime
COPY --chmod=0444 LICENSE /usr/share/licenses/linksense/LICENSE
COPY --chmod=0444 LICENSE-EXCEPTIONS.md ATTRIBUTION.md TRADEMARK.md NOTICE /usr/share/licenses/linksense/
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update \
  && apt-get install --yes --no-install-recommends \
    ca-certificates \
    curl \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation2 \
    fonts-noto-cjk \
    libreoffice-calc \
    libreoffice-core \
    libreoffice-draw \
    libreoffice-impress \
    libreoffice-writer \
    openssl \
    python3 \
    python3-uno \
  && uv venv --python /usr/bin/python3 --system-site-packages /opt/linksense/unoserver \
  && UV_NO_CACHE=1 uv pip install --python /opt/linksense/unoserver/bin/python "unoserver==3.7" \
  && /opt/linksense/unoserver/bin/python -c 'import uno, unoserver' \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /opt/linksense-api ./
ENV NODE_ENV=production
ENV PATH=/opt/linksense/unoserver/bin:${PATH}
USER node
EXPOSE 4000
CMD ["node", "dist/index.js"]
