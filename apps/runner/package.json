{
  "name": "@linksense/runner",
  "version": "0.1.0",
  "private": true,
  "license": "CPAL-1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../packages/shared/src/**/*.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=forks --maxWorkers=4",
    "lint": "eslint src test --max-warnings=0"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.2.4",
    "@linksense/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "eventsource-parser": "^3.1.0",
    "fastify": "^5.12.3",
    "gpt-tokenizer": "3.4.0",
    "ipaddr.js": "^2.5.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "pino": "^9.14.0",
    "proper-lockfile": "4.1.2",
    "proxy-agent": "8.0.2",
    "proxy-from-env": "2.1.0",
    "smol-toml": "1.8.0",
    "undici": "7.29.0",
    "ws": "8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  }
}
