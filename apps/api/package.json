{
  "name": "@linksense/api",
  "version": "0.1.0",
  "private": true,
  "license": "CPAL-1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-browser-extension.mjs && tsx watch --include \"../../packages/shared/src/**/*.ts\" src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-browser-extension.mjs && node dist/commands/bundle-linksense-docs.js && node ../../scripts/application-build.mjs api",
    "start": "node dist/index.js",
    "knowledge:reset-storage": "tsx --env-file-if-exists=../../.env src/commands/reset-knowledge-storage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser-extension.json",
    "build:browser-extension": "node scripts/build-browser-extension.mjs",
    "test": "vitest run --pool=threads --maxWorkers=4 --maxConcurrency=2",
    "test:voice:audio": "tsx test/integration/voice-audio-ffmpeg.ts",
    "lint": "eslint src test browser-extension --max-warnings=0",
    "runtime:convert-projects": "tsx --env-file-if-exists=../../.env src/commands/convert-project-runtime.ts",
    "runtime:convert-applications": "tsx --env-file-if-exists=../../.env ../../scripts/convert-application-environments.mts"
  },
