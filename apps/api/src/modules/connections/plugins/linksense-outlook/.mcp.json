{
  "mcpServers": {
    "outlook": {
      "command": "linksense-connection-mcp",
      "args": [
        "outlook"
      ],
      "env_vars": [
        "LINKSENSE_CONNECTION_ENDPOINT",
        "LINKSENSE_CONNECTION_TOKEN",
        "LINKSENSE_COLLABORATION_MODE"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 120
    }
  }
}
