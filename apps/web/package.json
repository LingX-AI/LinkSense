{
  "name": "@linksense/web",
  "private": true,
  "version": "0.1.0",
  "license": "CPAL-1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 18173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "node ../../scripts/format-web.mjs",
    "test": "pnpm run '/^test:(unit|e2e)$/'",
    "test:e2e": "node ../api/scripts/build-browser-extension.mjs && playwright test",
    "test:browser-extension": "node ../api/scripts/build-browser-extension.mjs && playwright test --config playwright.extension.config.ts",
    "test:unit": "vitest run --project application --maxWorkers=2 && vitest run --project components --project shared-components --project node --maxWorkers=4",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
