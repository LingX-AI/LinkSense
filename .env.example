# Copy this file to .env before running Docker Compose.
# Every example password, secret, access key, and provider credential is a
# non-production placeholder and MUST be replaced before production use.

COMPOSE_PROJECT_NAME=linksense
LINKSENSE_IMAGE_TAG=local
# Official installers replace this development marker with the immutable
# v-prefixed GitHub Release version.
LINKSENSE_VERSION=v0.0.0
LINKSENSE_WORKER_IMAGE=linksense-runner-worker:local
LINKSENSE_HTTP_PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (URL-safe credentials are required when embedded in DATABASE_URL).
POSTGRES_DB=linksense
POSTGRES_USER=linksense
POSTGRES_PASSWORD=dev-postgres-password-change-me
# When this host is `postgres`, the development launcher keeps the credentials
# and database name synchronized with the three POSTGRES_* values above.
DATABASE_URL=postgresql://linksense:dev-postgres-password-change-me@postgres:5432/linksense
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Redis is bound to host loopback for local operations and source development.
REDIS_PASSWORD=dev-redis-password-change-me
REDIS_URL=redis://:dev-redis-password-change-me@redis:6379/0
LINKSENSE_BILLING_TIME_ZONE=Asia/Shanghai
LINKSENSE_CLAWHUB_SYNC_TIME_ZONE=Asia/Shanghai
# Bounds the atomic ClawHub catalog publication/cleanup transaction (10s-30m).
LINKSENSE_CLAWHUB_SYNC_TRANSACTION_TIMEOUT_MS=300000
# Set to false to keep model settings visible to administrators while making
# every model configuration endpoint read-only.
LINKSENSE_ADMIN_MODEL_MANAGEMENT_ENABLED=true
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Browser-visible LinkSense origin. HTTP is supported for local or trusted-LAN
# deployments; use HTTPS before exposing LinkSense to the public internet.
LINKSENSE_PUBLIC_BASE_URL=http://localhost:8080

# Used by `pnpm dev` and `pnpm dev:host`. The default command runs Web, API,
# and the runner controller inside source-aware Linux containers. `dev:host`
# runs them as host processes and selects the explicitly non-isolated local
# worker provider. Keep every development port on host loopback by default.
# For `dev:host`, DATABASE_URL and REDIS_URL must use localhost or remote
# addresses that are reachable from this machine. MINIO_ENDPOINT has the same
# requirement when MinIO storage is selected. Compose service names such as
# postgres/redis and host.docker.internal are rejected.
LINKSENSE_DEV_WEB_ORIGIN=http://localhost:18173
LINKSENSE_DEV_WEB_BIND_ADDRESS=127.0.0.1
LINKSENSE_DEV_WEB_PORT=18173
LINKSENSE_DEV_API_ORIGIN=http://localhost:4000
LINKSENSE_DEV_API_BIND_ADDRESS=127.0.0.1
LINKSENSE_DEV_API_PORT=4000
LINKSENSE_DEV_RUNNER_BIND_ADDRESS=127.0.0.1
LINKSENSE_DEV_RUNNER_PORT=4010
# Docker image builds use domestic Debian mirrors by default. Override both
# values together when the build host has a faster trusted mirror.
DEBIAN_MIRROR_URL=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR_URL=http://security.debian.org/debian-security
# Keep false in production unless the container platform explicitly documents
# that public DNS is represented by a trusted 198.18.0.0/15 egress proxy.
LINKSENSE_SAFE_HTTP_ALLOW_BENCHMARK_PROXY=false

# These five values must each be at least 32 characters and must be different.
LINKSENSE_JWT_SECRET=dev-only-jwt-secret-change-before-production-00000001
LINKSENSE_INITIALIZATION_TOKEN=
LINKSENSE_LOGIN_RATE_LIMIT_HMAC_SECRET=dev-only-login-hmac-change-before-production-000002
LINKSENSE_PASSWORD_RESET_RATE_LIMIT_HMAC_SECRET=dev-only-reset-hmac-change-before-production-000003
LINKSENSE_CREDENTIAL_MASTER_KEY=dev-only-credential-key-change-before-production-00004
LINKSENSE_RUNNER_SHARED_SECRET=dev-only-runner-secret-change-before-production-000005
LINKSENSE_CREDENTIAL_KEY_ID=v1

LINKSENSE_INVALID_AUTH_TOKEN_RETENTION_DAYS=90
LINKSENSE_LOCAL_LOGIN_EMAIL_FAILURE_LIMIT=5
LINKSENSE_LOCAL_LOGIN_EMAIL_WINDOW_SECONDS=900
LINKSENSE_LOCAL_LOGIN_EMAIL_COOLDOWN_SECONDS=900
LINKSENSE_LOCAL_LOGIN_IP_FAILURE_LIMIT=100
LINKSENSE_LOCAL_LOGIN_IP_WINDOW_SECONDS=600
LINKSENSE_LOCAL_LOGIN_IP_COOLDOWN_SECONDS=600
LINKSENSE_PASSWORD_RESET_EMAIL_LIMIT=3
LINKSENSE_PASSWORD_RESET_EMAIL_WINDOW_SECONDS=900
LINKSENSE_PASSWORD_RESET_IP_LIMIT=20
LINKSENSE_PASSWORD_RESET_IP_WINDOW_SECONDS=3600
LINKSENSE_PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Controller and per-user task workers. The shared limits are global defaults;
# one idle worker is retained per user for reuse and stopped after 900 seconds.
# Dynamic workers never receive the Docker socket.
LINKSENSE_MAX_CONCURRENT_CONVERSATIONS=500
LINKSENSE_RUNNER_APP_SERVER_PROCESS_LIMIT=20
LINKSENSE_CODEX_APP_SERVER_IDLE_TTL_SECONDS=900
LINKSENSE_WORKER_IDLE_TTL_SECONDS=900
# Keep workers available for controller and development hot restarts. An
# authenticated development-only endpoint lets `pnpm dev:stop` remove the
# current deployment's dynamic workers before Compose removes their networks.
LINKSENSE_REMOVE_WORKERS_ON_SHUTDOWN=false
LINKSENSE_WORKER_READY_TIMEOUT_SECONDS=60
# Innermost controller-to-API knowledge-search budget. Runner derives slightly
# larger worker, MCP helper and Codex tool budgets so outer hops cannot time out
# before the API request they own.
LINKSENSE_KNOWLEDGE_SEARCH_TIMEOUT_MS=200000
LINKSENSE_WORKER_PORT=4010
LINKSENSE_WORKER_MEMORY_MB=4096
LINKSENSE_WORKER_CPUS=2
# Linux cgroups count both processes and threads. This budget covers the
# default 20 Codex app-server runtimes plus MCP, browser and tool subprocesses.
LINKSENSE_WORKER_PIDS_LIMIT=4096
LINKSENSE_WORKER_TMPFS_MB=4096
LINKSENSE_WORKER_SHM_MB=2048
LINKSENSE_BROWSER_SESSION_LIMIT=2
LINKSENSE_AGENTS_TEMPLATE_VERSION=7
LINKSENSE_PYTHON_PACKAGE_INDEX_URL=https://pypi.org/simple/
LINKSENSE_NODE_PACKAGE_REGISTRY_URL=https://registry.npmjs.org/
PLAYWRIGHT_DOWNLOAD_HOST=
LINKSENSE_WORKER_BUILD_TARGET=worker
LINKSENSE_BROWSER_RUNTIME_CACHE_IMAGE=linksense-runner-worker:pro-latest
PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh

# Docker Engine control plane. Only the trusted runner controller mounts this
# socket. The API, Web, and dynamically created task workers must never mount it.
LINKSENSE_DOCKER_SOCKET_PATH=/var/run/docker.sock
LINKSENSE_DOCKER_API_VERSION=v1.45
LINKSENSE_DOCKER_COMPOSE_PROJECT_NAME=linksense

# Absolute host path shared by the API and runner controller. The portable
# default resolves from the current deployment directory on every host. Set an
# explicit absolute path here only when production uses a separate data disk.
# The development launcher expands ${PWD}, ${HOME}, $PWD, $HOME, and leading ~.
LINKSENSE_USER_DATA_ROOT=${PWD}/.data/users
# Production ignores the host path above and mounts Docker-managed external
# volumes at fixed container paths. The bootstrap command creates and labels
# these volumes; do not replace them with local-driver bind options.
LINKSENSE_USER_DATA_VOLUME=linksense-user-data
LINKSENSE_BACKUP_VOLUME=linksense-backups
LINKSENSE_REDIS_VOLUME=linksense-redis
LINKSENSE_WORKER_CONTROL_NETWORK=linksense-worker-control
LINKSENSE_WORKER_EGRESS_NETWORK=linksense-worker-egress

LINKSENSE_UPLOAD_MAX_FILE_SIZE_MB=100
LINKSENSE_UPLOAD_MAX_FILES_PER_CONVERSATION=100
# User attachment uploads accept any meaningful regular file. This legacy
# MIME list is ignored by Composer attachments; preview support is still
# controlled by separate preview safety checks.
LINKSENSE_UPLOAD_ALLOWED_TYPES=application/pdf,text/plain,text/csv,text/markdown,text/html,text/css,text/javascript,application/json,application/yaml,application/xml,application/zip,image/png,image/jpeg,image/webp,image/gif,image/avif,audio/mpeg,audio/mp4,audio/wav,audio/ogg,audio/opus,audio/aac,audio/flac,video/mp4,video/webm,video/ogg,video/quicktime,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation
# Legacy compatibility only; no longer used to reject Agent artifact
# registration.
LINKSENSE_ARTIFACT_ALLOWED_TYPES=application/pdf,text/plain,text/csv,text/markdown,text/html,text/css,text/javascript,application/json,application/yaml,application/xml,application/zip,image/png,image/jpeg,image/webp,image/gif,image/avif,audio/mpeg,audio/mp4,audio/wav,audio/ogg,audio/opus,audio/aac,audio/flac,video/mp4,video/webm,video/ogg,video/quicktime,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation
LINKSENSE_ARTIFACT_DOWNLOAD_TTL_SECONDS=7200

# Nginx must allow the 200 MiB knowledge-document limit plus multipart overhead.
NGINX_CLIENT_MAX_BODY_SIZE=210m

# MinIO is deployed and operated separately from this project. Pre-create both
# private buckets and grant the LinkSense application credential read/write
# access. The endpoint is a hostname only (no scheme or path) and must be
# reachable from the API container. MINIO_PUBLIC_URL is the origin embedded in
# browser-facing presigned URLs and must be reachable from the user's browser.
# For non-production Core development only, set this to local-filesystem and
# omit MINIO_ENDPOINT, MINIO_PUBLIC_URL, MINIO_ACCESS_KEY, and MINIO_SECRET_KEY.
# Objects are then stored below LINKSENSE_USER_DATA_ROOT/.object-storage.
LINKSENSE_OBJECT_STORAGE_PROVIDER=minio
MINIO_ACCESS_KEY=linksense-app
MINIO_SECRET_KEY=dev-minio-app-password-change-me
MINIO_BUCKET=linksense-files
MINIO_KNOWLEDGE_BUCKET=linksense-knowledge
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1

# Knowledge-base upload, Docling Hybrid chunking and parent-child vector index.
# These are deployment-level values and cannot be overridden per user, base,
# document, or request. Existing documents change only after a manual rebuild.
LINKSENSE_KB_MAX_FILE_SIZE_BYTES=209715200
LINKSENSE_KB_UPLOAD_MAX_FILES_PER_BATCH=100
LINKSENSE_KB_STORAGE_QUOTA_BYTES=10737418240
# This is the path visible inside every Docling RQ worker, not a LinkSense path.
# Mount the tokenizer matching the embedding model at exactly this location.
LINKSENSE_KB_HYBRID_TOKENIZER=/models/tokenizers/Qwen3-Embedding-4B
LINKSENSE_KB_HYBRID_MAX_TOKENS=768
LINKSENSE_KB_PARENT_MAX_TOKENS=3000
# Model endpoints, keys and model IDs are configured by an administrator in
# Model settings. Vector dimensions remain deployment-managed because they are
# part of the Elasticsearch index mapping.
LINKSENSE_KB_EMBEDDING_DIMENSIONS=2560
LINKSENSE_KB_EMBEDDING_MAX_INPUT_TOKENS=8192
LINKSENSE_KB_ELASTICSEARCH_URL=http://host.docker.internal:9200
LINKSENSE_KB_ELASTICSEARCH_USERNAME=elastic
LINKSENSE_KB_ELASTICSEARCH_PASSWORD=replace-with-elasticsearch-password
LINKSENSE_KB_ELASTICSEARCH_INDEX=linksense-knowledge

# Rerank enablement and connection settings are managed in Model settings.
# These operational safety limits remain deployment-managed.
LINKSENSE_KB_RERANK_TIMEOUT_MS=60000
LINKSENSE_KB_RERANK_MAX_INPUT_TOKENS=8192

LINKSENSE_KB_PARSING_CONCURRENCY=4
LINKSENSE_KB_CHUNKING_CONCURRENCY=8
LINKSENSE_KB_PARENTING_CONCURRENCY=8
LINKSENSE_KB_EMBEDDING_CONCURRENCY=8
LINKSENSE_KB_INDEXING_CONCURRENCY=8
LINKSENSE_KB_ACTIVATION_CONCURRENCY=16
LINKSENSE_KB_MAINTENANCE_REBUILD_CONCURRENCY=3

# Docling Serve is deployed separately.
DOCLING_SERVE_URL=http://host.docker.internal:5001
DOCLING_SERVE_API_KEY=replace-with-docling-service-key
DOCLING_SERVE_TENANT_ID=linksense
LINKSENSE_DOCLING_DOCUMENT_TIMEOUT_SECONDS=1800

# Optional SMTP fallback used when System Settings selects "inherit". Leave
# every field empty for not_configured; partial values are reported unavailable.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional browser OIDC fallback used in "inherit" mode. Configure all four.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional Teams SSO fallback used in "inherit" mode. Configure both fields.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=

HOST=0.0.0.0
PORT=4000
LINKSENSE_TRUST_PROXY=true
LINKSENSE_RUNNER_URL=http://runner:4010
LINKSENSE_API_INTERNAL_URL=http://api:4000
LINKSENSE_RUNNER_HOST=0.0.0.0
LINKSENSE_RUNNER_PORT=4010
# This is a fixed architecture contract, not a switch to a public listener.
LINKSENSE_CODEX_APP_SERVER_LISTEN=stdio://
CODEX_BIN=codex

# The image is pinned to the app-server schema version used by the adapter.
# Upgrade only together with schema regeneration and adapter verification.
CODEX_VERSION=0.150.1
