{
  "name": "@linksense/shared",
  "private": true,
  "version": "0.1.0",
  "license": "CPAL-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./local-browser": {
      "types": "./src/local-browser.ts",
      "development": "./src/local-browser.ts",
      "import": "./dist/local-browser.js"
    },
    "./browser-use": {
      "types": "./src/browser-use.ts",
      "development": "./src/browser-use.ts",
      "import": "./dist/browser-use.js"
    },
    "./logging": {
      "types": "./src/logging.ts",
      "development": "./src/logging.ts",
      "import": "./dist/logging.js"
    },
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src tests --pool=threads --maxWorkers=2 --no-isolate",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "es-toolkit": "1.53.2",
    "mdast-util-from-markdown": "2.1.0",
    "pino": "^9.14.0",
    "semver": "7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6",
    "vitest": "^4.1.10"
  }
}
